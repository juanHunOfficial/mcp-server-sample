# Bitbucket Cloud MCP Server Configuration
# Copy this file to .env and fill in your actual values

# Your Bitbucket username
BITBUCKET_USERNAME=your-email-goes-here

# Your Bitbucket API key
# Create one at: https://id.atlassian.com/manage-profile/security/api-tokens
BITBUCKET_TOKEN=your-access-token-goes-here

# Your default workspace name
BITBUCKET_DEFAULT_WORKSPACE=your-workspace-goes-here
